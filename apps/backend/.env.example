# Configuración de Jarvis. Copia este archivo a .env y completa los valores.
JARVIS_ENVIRONMENT=development

# Claves de proveedores de IA (ambas conviven: Gemini directo para lo inmediato, OpenRouter de escape).
JARVIS_OPENROUTER_API_KEY=
JARVIS_GEMINI_API_KEY=
# Modelo de texto del carril inmediato (Gemini directo).
JARVIS_GEMINI_TEXT_MODEL=gemini-2.5-flash
# TTS del podcast (Gemini directo). Vacío en la key de audio = adaptador interino.
JARVIS_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
JARVIS_GEMINI_TTS_VOICE=Kore

# Base de datos. Vacío = almacenes en memoria (útil para probar sin Postgres).
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# Feeds RSS/Atom del motor de Heraldo, separados por coma (opcional; vacío = sin fuentes).
JARVIS_HERALDO_FEEDS=

# Supabase Storage para el audio del podcast (vacío = almacenamiento interino en memoria).
JARVIS_SUPABASE_URL=
JARVIS_SUPABASE_SERVICE_KEY=
JARVIS_SUPABASE_BUCKET=podcasts

# Solo para el test de integración de pgvector (déjalo vacío para saltarlo).
# Con el docker-compose en puerto alterno: postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis
JARVIS_TEST_DATABASE_URL=
